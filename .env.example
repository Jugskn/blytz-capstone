# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Behind Railway / TLS-terminating proxy:
# USE_SECURE_PROXY_SSL_HEADER=True
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# When DEBUG=False, these default to True (override if needed):
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# Database — leave unset for SQLite; use MySQL via DATABASE_URL (PyMySQL)
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/blytz

# Blytz
MESSENGER_PAGE_USERNAME=your_page_username
PAYMENT_WINDOW_MINUTES=10
PROOF_MAX_UPLOAD_MB=15

# Stage O — Gemini AI design suggestions
# IMPORTANT: leave these lines UNCOMMENTED. A leading # means Django never sees the key
# and the editor stays on the local demo/mock fallback.
# Paste your key after = (no quotes, no spaces). Leave empty to disable live AI.
# Never commit a real key. Use .env only (gitignored).
GEMINI_API_KEY=
# Default: gemini-3.5-flash-lite (verified for new free-tier keys).
# Alt: gemini-3.1-flash-lite. Avoid gemini-2.5-* (404 for new users).
# gemini-3.8-flash may timeout on some networks/keys.
GEMINI_MODEL=gemini-3.5-flash-lite
AI_SUGGEST_RATE_LIMIT_PER_HOUR=5
AI_SUGGEST_RATE_LIMIT_WINDOW_SECONDS=3600
# Soft AI overflow past dashed print guide (px per side). Editor warning stays strict.
# Default 40 after Stage O.1.2 full flat panels (was 60 when panels were torso-only).
AI_PRINT_OVERFLOW_MARGIN_PX=40

# Email (console by default; later anymail HTTPS provider)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@blytz.local
# EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
